# Copy to backend/.env or export these before running the backend.
# NOTHING sensitive is committed: application.properties only reads these.

DB_URL=jdbc:postgresql://localhost:5432/namma_store_dev
DB_USERNAME=postgres
DB_PASSWORD=Sampath@123

APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ORIGIN=http://localhost:3000

APP_DELIVERY_CHARGE=49
APP_FREE_DELIVERY_ABOVE=499

# Cloudinary - PRIMARY image storage. Fill these in and every product /
# banner / category / influencer image upload becomes permanent, CDN-served
# and independent of this server's disk. Get them from
# https://console.cloudinary.com -> Dashboard (free tier is enough).
# See README.md "Cloudinary setup" for the full walkthrough.
CLOUDINARY_CLOUD_NAME=dkghxpwy8
CLOUDINARY_API_KEY=558397829751116
CLOUDINARY_API_SECRET=a2VLQEfcNiAtdglGNE0I_6Szuwc
CLOUDINARY_FOLDER=namma-store

# Fallback storage - only used when CLOUDINARY_* above is blank. Leave
# blank for local disk storage (./uploads) - fine for local dev ONLY.
# On most hosting (Render, Railway, etc.) this folder is wiped on every
# redeploy/restart, which is why images keep disappearing in production.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_DIR=uploads

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Auth (Firebase has been removed entirely) ----
# Signs every session token this server issues. MUST be a long, random,
# secret value in production - generate one with:  openssl rand -base64 48
# Anyone who has this value can mint a token for ANY account.
APP_AUTH_JWT_SECRET=change-this-to-a-long-random-secret

# The ONE super admin account. Fixed on every startup by SuperAdminSeeder -
# change SUPER_ADMIN_PASSWORD and restart the backend at any time to reset
# it, no database access required. CHANGE THE DEFAULT PASSWORD BELOW.
SUPER_ADMIN_NAME=Namma Store Admin
SUPER_ADMIN_EMAIL=admin@nammastore.in
SUPER_ADMIN_PASSWORD=1234

# Delivery bands (rupees)
APP_SMALL_ORDER_THRESHOLD=200
APP_SMALL_ORDER_CHARGE=40
