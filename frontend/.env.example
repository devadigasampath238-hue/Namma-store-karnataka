# Copy this file to .env.local and fill in your own values.
# The real .env.local is intentionally NOT shipped in this zip.
#
# Firebase has been removed - there is nothing to configure here for auth
# anymore. Login/session config all lives on the BACKEND now (see
# backend/src/main/resources/application.properties: APP_AUTH_JWT_SECRET,
# SUPER_ADMIN_EMAIL, SUPER_ADMIN_PASSWORD, SUPER_ADMIN_NAME).

NEXT_PUBLIC_API_URL=http://localhost:8080

# Razorpay: no frontend key is required yet (payments are simulated).
